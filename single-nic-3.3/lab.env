# Public settings only. Run lab.sh on Proxmox as root with Bash 5+.
HOST_IP=192.168.0.253
HOME_GATEWAY=192.168.0.1
HOME_BRIDGE=vmbr0
PHYSICAL_NIC=nic0
LAB_BRIDGE=vmbr-lab
LAB_CIDR=10.50.0.0/24
SO_IP=192.168.0.252
KALI_IP=10.50.0.10
WINDOWS_IP=10.50.0.20
UBUNTU_IP=10.50.0.30
FIRST_VMID=200
HOST_RESERVE_MB=8192
# Per-VM RAM in MiB, CPU cores, and system disk size in GiB.
# Set these BEFORE the first preflight. Existing VMs are never resized here.
SO_MEMORY_MB=32768
SO_CORES=6
SO_DISK_GB=800
KALI_MEMORY_MB=6144
KALI_CORES=4
KALI_DISK_GB=80
WINDOWS_MEMORY_MB=8192
WINDOWS_CORES=4
WINDOWS_DISK_GB=100
UBUNTU_MEMORY_MB=4096
UBUNTU_CORES=2
UBUNTU_DISK_GB=60
# 1 preserves the original SO disk reduction (minimum 300 GiB); 0 requires
# exactly SO_DISK_GB. Other VM disks always use their requested sizes.
SO_DISK_AUTO_SHRINK=1
# Proxmox storage IDs, not device paths. Blank VM_STORAGE means auto-detect.
# Blank per-VM storage inherits VM_STORAGE (or its auto-detected selection).
# Choose IDs backed by SSD/HDD in Datacenter -> Storage; no drives are formatted.
VM_STORAGE=
SO_STORAGE=
KALI_STORAGE=
WINDOWS_STORAGE=
UBUNTU_STORAGE=
# Local directory storage for verified installer/tools ISOs and snippets.
FILE_STORAGE=
SO_BUILD=3.3.0-20260911
SO_ISO=securityonion-3.3.0-20260911.iso
SO_SHA256=0938c73b76ce30ec9e4394d312c79ea7cac721b6818541697279a6221f7d870d
SO_URL=https://download.securityonion.net/file/securityonion/securityonion-3.3.0-20260911.iso
SO_FPR=C804A93D36BE0C733EA196447C1060B7FE507013
KALI_FPR=827C8569F2518CC677FECA1AED65462EC8D5E4C5
UBUNTU_FPR=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81
WINDOWS_ISO=windows11-enterprise-26h2-en-us-x64.iso
WINDOWS_URL='https://go.microsoft.com/fwlink/?LinkId=2382600&clcid=0x409&culture=en-us&country=us'
WINDOWS_SHA256=bc3f24086ebadc94489066b5ad78089e2cf5c3491e90e790bb81a2b199c10e38
