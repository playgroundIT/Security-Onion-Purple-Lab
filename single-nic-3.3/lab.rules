alert tcp 10.50.0.10 any -> [10.50.0.20,10.50.0.30] any (msg:"SO LAB TCP SYN scan"; flags:S; flow:stateless; threshold:type both,track by_src,count 10,seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)
alert http 10.50.0.10 any -> 10.50.0.30 8080 (msg:"SO LAB HTTP command injection attempt"; flow:established,to_server; http.uri; content:"/run?cmd="; startswith; classtype:web-application-attack; sid:1000002; rev:1;)
